{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [],
      "palette": []
    },
    "shadow": {
      "defaultPresets": false
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "defaultFontSizes": false,
      "fontSizes": [],
      "fontStyle": false,
      "fontWeight": false,
      "letterSpacing": false,
      "textDecoration": false,
      "textTransform": false,
      "writingMode": false
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": false
        }
      }
    }
  },
  "styles": {
    "elements": {
      "button": {
        "border": {
          "radius": "inherit"
        },
        "spacing": {
          "padding": {
            "top": "inherit",
            "right": "inherit",
            "bottom": "inherit",
            "left": "inherit"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "spacing": {
              "padding": {
                "top": "inherit",
                "right": "inherit",
                "bottom": "inherit",
                "left": "inherit"
              }
            }
          }
        }
      }
    }
  }
}
